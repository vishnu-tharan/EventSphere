# SETUP_ACCOUNTS=1
# INITIAL_ADMIN_PASSWORD=
# INITIAL_STAFF_PASSWORD=
# INITIAL_ATTENDEE_PASSWORD=
# Optional sample venues and events on a new database:
# SEED_SAMPLE_DATA=1
